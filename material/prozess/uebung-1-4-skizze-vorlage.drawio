      <mxCell id="note_id" value="Die kontakt_id kommt aus dem Kasten „Kontakt bereitstellen“, nicht vom Modell." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
