      </mxCell>
      <mxCell id="note_not" value="&lt;b&gt;Was der Workflow nicht tut:&lt;/b&gt; kein Versand, keine Terminbuchung, keine Änderung im CRM. Die Freigabe ist eine Person, kein Kasten im Workflow." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
        <mxGeometry x="40" y="380" width="600" height="50" as="geometry" />
      </mxCell>
      <mxCell id="note_check" value="&lt;b&gt;Prüfen vor dem Bauen:&lt;/b&gt; Eingabe und Ausgabe mit Feldnamen benannt? Jeder Kasten genau eine Art? Pfeile mit Feldern beschriftet? Erreicht die kontakt_id den letzten Kasten? Nicht mehr Kästen als später Knoten?" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
        <mxGeometry x="40" y="440" width="700" height="60" as="geometry" />
      </mxCell>
