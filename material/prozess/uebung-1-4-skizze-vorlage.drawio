      <mxCell id="ablage" value="&lt;b&gt;Ergebnis zur Prüfung ablegen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;kontakt_id, ergebnis, freigabe = offen&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
